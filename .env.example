# Sao chép thành .env rồi chỉnh nếu cần: cp .env.example .env
# docker compose tự đọc file .env ở cùng thư mục.

# --- CSDL --------------------------------------------------------------------
POSTGRES_USER=geostrata
POSTGRES_PASSWORD=geostrata
POSTGRES_DB=geostrata
# Cổng publish ra máy host (5433 để không đụng PostgreSQL cài sẵn ở 5432)
DB_PORT=5433

# --- Cổng dịch vụ ------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080
ADMINER_PORT=8081

# --- Tham số nghiệp vụ -------------------------------------------------------
# Bán kính tìm kiếm mặc định (m). Frontend đọc lại qua GET /api/config,
# nên chỉ cần khai báo ở đây, không hard-code trong code frontend.
DEFAULT_SEARCH_RADIUS_M=150
MAX_SEARCH_RADIUS_M=5000

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Đặt false nếu không muốn backend tự nạp dữ liệu mẫu lúc khởi động.
SEED_ON_STARTUP=true

# --- Xác thực ----------------------------------------------------------------
# Thời gian sống của một phiên đăng nhập (giờ).
SESSION_TTL_HOURS=12

# Chỉ dùng khi CSDL chưa có tài khoản nào VÀ không tìm thấy data/users.json.
# Tài khoản mặc định nằm trong data/users.json — ĐỔI MẬT KHẨU NGAY sau lần
# đăng nhập đầu tiên, hoặc sửa file đó trước khi khởi động lần đầu.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Cho phép tự đăng ký. Tài khoản tự đăng ký luôn có vai trò "user" (chỉ tra cứu).
ALLOW_SELF_REGISTRATION=true
# Giới hạn dung lượng ảnh đại diện (byte). Mặc định 500 KB.
MAX_AVATAR_BYTES=512000

# --- Tra cứu địa điểm trên bản đồ ---------------------------------------------
# Dùng Nominatim của OpenStreetMap, không cần API key. Đặt false để tắt ô tìm kiếm.
GEOCODE_ENABLED=true
# Máy chủ công cộng giới hạn 1 yêu cầu/giây. Nếu dùng nhiều, hãy tự dựng
# Nominatim rồi trỏ biến này vào đó.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Giới hạn kết quả trong Việt Nam. Để trống nếu cần tra cứu toàn cầu.
GEOCODE_COUNTRY_CODES=vn

# --- Ví xu và thanh toán ------------------------------------------------------
# Đặt false để tắt hẳn tính năng: mọi hố khoan xem miễn phí, ẩn ví và màn thống kê.
COINS_ENABLED=true
# Giá mở khoá một hố khoan (xu). Đặt 0 để miễn phí cho tất cả.
BOREHOLE_UNLOCK_COST=10
# Xu tặng cho tài khoản mới đăng ký, để dùng thử trước khi cần nạp.
SIGNUP_BONUS_COINS=20
# Thông tin chuyển khoản hiện cho người dùng — ĐỔI THÀNH TÀI KHOẢN THẬT.
BANK_NAME=Ngan hang TMCP Ngoai thuong Viet Nam (Vietcombank)
BANK_ACCOUNT_NUMBER=0123456789
BANK_ACCOUNT_NAME=CONG TY GEOSTRATA
